<?xml version="1.0"?>
<package format="3">
  <name>hydra_sandbox</name>
  <version>0.2.0</version>
  <description>The hydra_sandbox package</description>
  <author email="arbogastaw@gmail.com">Alex Arbogast</author>
  <maintainer email="arbogastaw@gmail.com">Alex Arbogast</maintainer>
  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>xacro</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>joint_state_controller</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>za_description</exec_depend>
  <exec_depend>za_robot</exec_depend>
  <exec_depend>cartesian_planning_server</exec_depend>
  <exec_depend>pyrobopath_execution</exec_depend>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>control_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
