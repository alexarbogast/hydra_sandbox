<?xml version="1.0"?>
<launch>
  <arg name="sim"  default="true" doc="Should sim hardware be launched?"/>
  <arg name="exec" default="planning" doc="Schedule execution type. One of 'control', 'planning'"/>
  <arg name="rviz" default="true" doc="Should RVIz be launched?"/>
  <arg name="tool" default="marker_tool" doc="One of 'typhoon_extruder', 'marker_tool', 'tool0'"/>

  <!-- GDB functionality -->
  <arg name="debug" default="false" />
  <arg unless="$(arg debug)" name="launch_prefix" value=""/>
  <arg     if="$(arg debug)" name="launch_prefix" value="gdb --ex run --args"/>

  <!-- Simulation -->
  <group if="$(arg sim)">
    <include file="$(find hydra_bringup)/launch/hydra_system_sim.launch">
      <arg name="rviz" value="false"/>
      <arg name="tool" value="$(arg tool)"/>
    </include>
  </group>

  <!-- Visualization -->
  <group if="$(arg rviz)">
    <include file="$(find hydra_bringup)/launch/hydra_visualization.launch">
      <arg name="load_robot_description" value="true"/>
      <arg name="rvizconfig" value="$(find hydra_sandbox)/config/hydra_sandbox.rviz"/>
      <arg name="tool" value="$(arg tool)"/>
    </include>
  </group>

  <!-- Execution modes -->
  <group if="$(eval arg('exec') == 'planning')">
    <rosparam file="$(find hydra_sandbox)/config/cartesian_planners.yaml" command="load"/>
    <include file="$(find hydra_sandbox)/launch/cartesian_planning_servers.launch"/>
  </group>

  <group if="$(eval arg('exec') == 'control')">
    <include if="$(arg sim)" file="$(find hydra_sandbox)/launch/taskspace_controllers.launch"/>
    <include file="$(find hydra_sandbox)/launch/schedule_execution_servers.launch"/>
  </group>
</launch>
