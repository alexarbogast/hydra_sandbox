<?xml version="1.0"?>
<launch>
  <rosparam file="$(find hydra_sandbox)/config/hydra_controllers.yaml" command="load"/>

  <node ns="rob1" name="controllers_spawner" pkg="controller_manager" type="controller_manager"
        respawn="false" output="screen"
        args="load pose_controller"/>

  <node ns="rob2" name="controllers_spawner" pkg="controller_manager" type="controller_manager"
        respawn="false" output="screen"
        args="load pose_controller"/>
</launch>
